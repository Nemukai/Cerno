# Copy to .env.local and fill in values. Never commit .env.local.

# API server
CERNO_API_HOST=127.0.0.1
CERNO_API_PORT=8765

# Vite dev server URL (used by pywebview in dev mode)
CERNO_FRONTEND_DEV_URL=http://127.0.0.1:5173

# LLM (OpenAI Responses API by default)
CERNO_LLM_ENABLED=true
CERNO_LLM_PROVIDER=openai
CERNO_LLM_BASE_URL=https://api.openai.com/v1
CERNO_LLM_API_KEY=
CERNO_LLM_MODEL=gpt-5.4
CERNO_LLM_TIMEOUT_SECONDS=300

# Reasoning effort: off | minimal | low | medium | high | xhigh
# Chat and dashboard use this as the default; link discovery escalates to "high".
CERNO_LLM_REASONING_EFFORT=medium
# Reasoning summary: off | auto | concise | detailed
CERNO_LLM_REASONING_SUMMARY=auto

CERNO_LLM_SITE_URL=http://localhost
CERNO_LLM_APP_NAME=Cerno

# If heuristic schema confidence falls below this, ask the model to verify.
CERNO_SCHEMA_CONFIDENCE_THRESHOLD=0.85

# Data root (defaults to ~/.cerno if unset)
# CERNO_DATA_ROOT=
