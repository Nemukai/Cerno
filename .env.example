# Copy to .env.local and fill in values. Never commit .env.local.

# API server
CERNO_APP_ENV=development
CERNO_API_HOST=127.0.0.1
CERNO_API_PORT=8765

# Vite dev server URL (used by pywebview in dev mode)
CERNO_FRONTEND_DEV_URL=http://127.0.0.1:5173

# LLM (OpenAI Responses API by default)
CERNO_LLM_ENABLED=true
CERNO_LLM_PROVIDER=openai
CERNO_LLM_BASE_URL=https://api.openai.com/v1
CERNO_LLM_API_KEY=
CERNO_LLM_MODEL=gpt-5.5
CERNO_CHAT_MODEL=gpt-5.4-mini
CERNO_LLM_TIMEOUT_SECONDS=300

# Reasoning effort: off | minimal | low | medium | high | xhigh
# Chat and dashboard use this as the default; link discovery escalates to "high".
CERNO_LLM_REASONING_EFFORT=medium
# Reasoning summary: off | auto | concise | detailed
CERNO_LLM_REASONING_SUMMARY=auto

CERNO_LLM_SITE_URL=http://localhost
CERNO_LLM_APP_NAME=Cerno

# Maximum LLM round-trips per chat message when tools are used.
CERNO_CHAT_MAX_LLM_CALLS=20

# If heuristic schema confidence falls below this, ask the model to verify.
CERNO_SCHEMA_CONFIDENCE_THRESHOLD=0.85

# Auth/session
CERNO_FRONTEND_ORIGIN=http://127.0.0.1:5173
CERNO_GOOGLE_CLIENT_ID=
CERNO_GOOGLE_CLIENT_SECRET=
CERNO_SESSION_SECRET=dev-only-change-me
CERNO_OPERATOR_EMAILS=
# Comma-separated emails with site-owner access (approve users, manage orgs).
CERNO_SITE_OWNER_EMAILS=

# Required database and object storage.
# Cerno uses Postgres for metadata and Cloudflare R2 for uploaded/generated files.
CERNO_POSTGRES_URL=
CERNO_R2_ACCOUNT_ID=
CERNO_R2_ACCESS_KEY_ID=
CERNO_R2_SECRET_ACCESS_KEY=
CERNO_R2_ENDPOINT_URL=
CERNO_R2_BUCKET_NAME=

# Beta/user limits
CERNO_PER_USER_QUOTA_GB=5
CERNO_DAILY_TOKEN_CAP=200000

# Access-request / contact form (landing page "Request access").
# Delivered via Resend; the "from" address must be on a Resend-verified domain.
CERNO_RESEND_API_KEY=
CERNO_RESEND_FROM_EMAIL=Cerno <cerno@nemukai.com>
CERNO_CONTACT_EMAIL=nik@nemukai.com
